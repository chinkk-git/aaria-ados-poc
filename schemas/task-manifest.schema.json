{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ados/task-manifest.schema.json",
  "title": "ADOS trusted per-issue dispatch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_number", "authorized_actors", "repository", "task_id", "branch",
    "expected_base_sha", "permitted_paths", "task_prompt", "acceptance_criteria",
    "cost_ceiling_usd", "provider", "provider_model", "provider_model_revision", "provider_model_sha256", "inference_authorization_id", "max_provider_calls", "max_workflow_recoveries", "enabled"
  ],
  "properties": {
    "issue_number": {"type": "integer", "minimum": 1},
    "authorized_actors": {
      "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$"}
    },
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "task_id": {"type": "string", "pattern": "^ADOS-POC-[0-9]{3}$"},
    "branch": {"type": "string", "pattern": "^(feature|experiment)/[a-z0-9][a-z0-9._/-]*$"},
    "expected_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "permitted_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task_prompt": {"type": "string", "minLength": 1, "maxLength": 12000},
    "acceptance_criteria": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "cost_ceiling_usd": {"const": 0.0},
    "provider": {"const": "local"},
    "provider_model": {"const": "Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF"},
    "provider_model_revision": {"const": "f86cb2c1fa58255f8052cc32aeede1b7482d4361"},
    "provider_model_sha256": {"const": "cc324af070c2ecbfd324a30884d2f951a7ff756aba85cb811a6ec436933bb046"},
    "inference_authorization_id": {"type": ["string", "null"], "pattern": "^AUTH-[A-Z0-9-]{1,64}$"},
    "max_provider_calls": {"const": 1},
    "max_workflow_recoveries": {"type": "integer", "minimum": 0, "maximum": 3},
    "enabled": {"type": "boolean"}
  }
}
